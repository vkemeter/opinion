{
	"name": "vkemeter/opinion",
	"description": "Collects feedback from editors including a screenshot and environment details and delivers it by email",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3",
		"extension",
		"feedback"
	],
	"authors": [
		{
			"name": "Volker Kemeter",
			"role": "Developer",
			"email": "v.kemeter@fonda.at"
		}
	],
	"homepage": "https://github.com/vkemeter/opinion",
	"require": {
		"php": "^8.4",
		"typo3/cms-adminpanel": "^14.3",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"saschaegerer/phpstan-typo3": "^3.0",
		"typo3/testing-framework": "^9.5"
	},
	"autoload": {
		"psr-4": {
			"Vkemeter\\Opinion\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Vkemeter\\Opinion\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "opinion",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"check": [
			"@check:cs",
			"@check:stan"
		],
		"check:cs": [
			"php-cs-fixer fix --dry-run --diff -v"
		],
		"check:stan": [
			"phpstan analyse -c Build/phpstan/phpstan.neon --memory-limit=-1"
		],
		"fix:cs": [
			"php-cs-fixer fix"
		],
		"test": [
			"@test:unit",
			"@test:functional"
		],
		"test:functional": [
			"phpunit -c Build/phpunit/FunctionalTests.xml"
		],
		"test:unit": [
			"phpunit -c Build/phpunit/UnitTests.xml"
		]
	}
}
