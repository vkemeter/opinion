{
	"name": "vkemeter/opinion",
	"description": "Collects feedback from editors including a screenshot and environment details and delivers it by email",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3",
		"extension",
		"feedback"
	],
	"authors": [
		{
			"name": "Volker Kemeter",
			"role": "Developer",
			"email": "v.kemeter@fonda.at"
		}
	],
	"homepage": "https://github.com/vkemeter/opinion",
	"support": {
		"issues": "https://github.com/vkemeter/opinion/issues",
		"source": "https://github.com/vkemeter/opinion"
	},
	"require": {
		"php": "^8.4",
		"typo3/cms-adminpanel": "^14.3",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"a9f/typo3-fractor": "^1.1",
		"friendsofphp/php-cs-fixer": "^3.95",
		"kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"saschaegerer/phpstan-typo3": "^3.0",
		"ssch/typo3-rector": "^3.17",
		"typo3/cms-dashboard": "^14.3",
		"typo3/testing-framework": "^9.5"
	},
	"suggest": {
		"typo3/cms-dashboard": "Dashboard widgets for open feedback, new messages and the latest feedback"
	},
	"autoload": {
		"psr-4": {
			"Vkemeter\\Opinion\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Vkemeter\\Opinion\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"a9f/fractor-extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "opinion",
			"version": "2.0.1",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"check": [
			"@check:cs",
			"@check:stan",
			"@check:rector",
			"@check:fractor"
		],
		"check:cs": [
			"php-cs-fixer fix --dry-run --diff -v"
		],
		"check:fractor": [
			"fractor process -c Build/fractor/fractor.php --dry-run"
		],
		"check:rector": [
			"rector process -c Build/rector/rector.php --dry-run"
		],
		"check:stan": [
			"phpstan analyse -c Build/phpstan/phpstan.neon --memory-limit=-1"
		],
		"fix:cs": [
			"php-cs-fixer fix"
		],
		"test": [
			"@test:unit",
			"@test:functional"
		],
		"test:functional": [
			"phpunit -c Build/phpunit/FunctionalTests.xml"
		],
		"test:unit": [
			"phpunit -c Build/phpunit/UnitTests.xml"
		]
	}
}
